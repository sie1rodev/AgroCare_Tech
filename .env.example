# Copie este arquivo para .env e preencha os valores (o .env não vai para o Git).
# Veja no README.md onde obter cada token.

# Banco e RabbitMQ: precisam bater com o docker-compose.yml
DB_USERNAME=mvcagrocaretech
DB_PASSWORD=mvcagrocaretech
RABBITMQ_USERNAME=mvcagrocaretech
RABBITMQ_PASSWORD=mvcagrocaretech

# Usuário padrão do Spring Security (qualquer valor)
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin

# Login com GitHub (OAuth App)
GITHUB_ID=
GITHUB_SECRET=

# Login com Google (OAuth Client)
GOOGLE_ID=
GOOGLE_SECRET=

# Chat com IA (Groq)
API_GENAI=
